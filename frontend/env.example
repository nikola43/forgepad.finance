NEXT_PUBLIC_PROJECT_ID=

# Target chain: 56 = BSC mainnet (default), 97 = BSC testnet, other = local fork.
NEXT_PUBLIC_BSC_CHAIN_ID=56

# RPC + explorer. Optional — the app falls back to public defaults per chain.
# Mainnet defaults shown; for testnet (97) use:
#   NEXT_PUBLIC_BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
#   NEXT_PUBLIC_BSC_EXPLORER_URL=https://testnet.bscscan.com
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
NEXT_PUBLIC_BSC_EXPLORER_URL=https://bscscan.com
