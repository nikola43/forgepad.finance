# The app imports transitive packages it doesn't declare (e.g.
# @reown/appkit-controllers, pulled in by @reown/appkit). npm's flat node_modules
# exposed them; pnpm's strict layout does not, which broke `next build`. Hoist
# like npm so those imports resolve without hunting down every undeclared dep.
# ponytail: shamefully-hoist covers it; declare the deps properly if you ever
# want strict isolation back.
shamefully-hoist=true
